# API base URL — leave empty in development (Vite proxy handles it)
# In production: https://api.yourdomain.com
VITE_API_URL=

# Em localhost o host nao tem subdominio pra resolver o tenant, entao o
# frontend precisa dizer qual e. Sem isso toda chamada volta "Tenant not
# found" — o fallback do backend por host so cobre o tenant padrao do seed,
# e so quando VITE_TENANT_SLUG nao mandar nada diferente dele.
VITE_TENANT_SLUG=befit
