# Database
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=change_me_min_32_chars_for_production

# Rails — gere com: docker compose exec api bin/rails secret
SECRET_KEY_BASE=

# Criptografia dos segredos dos tenants (chave do gateway, segredo do callback,
# senha SMTP, chave S3). Em desenvolvimento pode ficar vazio: cai numa chave
# fixa de desenvolvimento. Em PRODUCAO a aplicacao NAO SOBE sem estas tres —
# de proposito, para nunca voltar a gravar segredo em texto puro em silencio.
# Gere o conjunto com: docker compose exec api bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# AI (OpenRouter) — deixe VAZIO para usar a heuristica local por nome de arquivo.
# Uma chave invalida aqui faz a triagem tentar a IA, tomar 401 e cair no fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Frontend (o dev server do Vite sobe na 3000)
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=app.local
APP_NAME=My App
APP_URL=http://localhost:3000

# CORS (comma-separated additional origins)
CORS_ORIGINS=

# Gateway de pagamento (Orbe PSP)
# As credenciais sao por tenant, em Configuracoes > Pagamento no admin.
# Aqui fica so a base publica do callback: o gateway precisa alcancar este
# endereco, entao localhost nao serve — use um tunel ou o ambiente publicado.
# Sem valor, cai no APP_URL acima.
PSP_CALLBACK_BASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (optional - defaults to letter_opener in development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# AWS S3 (optional - defaults to local storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
