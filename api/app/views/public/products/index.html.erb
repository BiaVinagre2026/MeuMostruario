<% content_for :title, "Produtos" %>
<% content_for :description, seo_description("Catalogo B2B de produtos publicados de #{current_tenant&.name || 'Meu Mostruario'}.") %>
<% content_for :head do %>
  <%= json_ld_item_list("Produtos #{current_tenant&.name}", @products.to_a) %>
<% end %>

<div class="max-w-7xl mx-auto px-6 py-12">
  <section style="border-bottom:1px solid var(--brand-border);padding-bottom:36px;margin-bottom:32px;">
    <div style="font-size:10px;letter-spacing:0.16em;text-transform:uppercase;font-family:var(--font-mono);color:var(--brand-muted);margin-bottom:12px;">Catalogo B2B</div>
    <h1 style="font-family:var(--font-heading);font-size:clamp(2.25rem,7vw,5rem);font-weight:300;letter-spacing:-0.03em;line-height:1;margin-bottom:16px;">Produtos</h1>
    <p style="max-width:620px;font-size:15px;line-height:1.7;color:var(--brand-muted);">
      Explore pecas publicadas, colecoes ativas, cores e precos de atacado. Lojistas cadastrados podem montar pedidos por grade no painel B2B.
    </p>
  </section>

  <form action="<%= public_products_path %>" method="get" style="display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:32px;">
    <input type="search" name="q" value="<%= params[:q] %>" placeholder="Buscar por nome"
           style="width:100%;padding:12px 14px;border:1px solid var(--brand-border);font-size:14px;outline:none;box-sizing:border-box;" />
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <select name="colecao" style="padding:10px 12px;border:1px solid var(--brand-border);background:#fff;font-size:13px;min-width:180px;">
        <option value="">Todas as colecoes</option>
        <% @collections.each do |collection| %>
          <option value="<%= collection.slug %>" <%= "selected" if params[:colecao] == collection.slug %>><%= collection.name %></option>
        <% end %>
      </select>
      <select name="categoria" style="padding:10px 12px;border:1px solid var(--brand-border);background:#fff;font-size:13px;min-width:180px;">
        <option value="">Todas as categorias</option>
        <% @categories.each do |category| %>
          <option value="<%= category.slug %>" <%= "selected" if params[:categoria] == category.slug %>><%= category.name %></option>
        <% end %>
      </select>
      <button type="submit" style="padding:11px 20px;background:var(--brand-foreground);color:#fff;border:0;cursor:pointer;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;font-family:var(--font-mono);">Filtrar</button>
      <%= link_to "Limpar", public_products_path, style: "padding:10px 16px;border:1px solid var(--brand-border);color:var(--brand-muted);text-decoration:none;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;font-family:var(--font-mono);" %>
    </div>
  </form>

  <% if @products.any? %>
    <div style="font-family:var(--font-mono);font-size:11px;color:var(--brand-muted);margin-bottom:16px;">
      <%= pluralize(@products.size, "produto encontrado", "produtos encontrados") %>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% @products.each do |product| %>
        <%= link_to public_product_path(product.slug), style: "text-decoration:none;color:inherit;display:block;" do %>
          <div style="aspect-ratio:3/4;background:var(--brand-surface);overflow:hidden;margin-bottom:12px;">
            <% if (img = cover_url(product)) %>
              <img src="<%= img %>" alt="<%= product.name %>" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
            <% end %>
          </div>
          <% if product.collection %>
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--brand-muted);margin-bottom:4px;"><%= product.collection.name %></div>
          <% end %>
          <div style="font-size:14px;font-weight:500;margin-bottom:2px;"><%= product.name %></div>
          <div style="font-family:var(--font-mono);font-size:11px;color:var(--brand-muted);">SKU <%= product.sku %></div>
          <div style="font-family:var(--font-mono);font-size:13px;margin-top:4px;font-weight:600;color:var(--brand-primary);"><%= format_brl(product.price_wholesale) %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div style="border:1px solid var(--brand-border);padding:48px;text-align:center;color:var(--brand-muted);">
      Nenhum produto publicado para estes filtros.
    </div>
  <% end %>
</div>
